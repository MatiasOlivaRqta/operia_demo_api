DATABASE_URL=postgresql://operia:operia_dev_password@localhost:5432/operia
DATABASE_URL_TEST=postgresql://operia:operia_dev_password@localhost:5432/operia_test

# Back en el host, SMTP de Mailpit publicado por Compose.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=operia@operia.local
CASH_ALERT_EMAILS=
MAIL_POLL_SECONDS=15
MAIL_MAX_ATTEMPTS=6
# Token del bot de Telegram; necesario para generar links y recibir mensajes.
TELEGRAM_BOT_TOKEN=
# Nombre público del bot (sin @); necesario para generar links.
TELEGRAM_BOT_USERNAME=
# Intervalo de long polling en segundos (0 desactiva Telegram). Solo UNA instancia del back debe tener polling activo.
TELEGRAM_POLL_SECONDS=0
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000
# GEOREF_BASE_URL=https://apis.datos.gob.ar/georef/api
SESSION_TTL_HOURS=8
# Inactividad máxima de sesión en minutos; 0 desactiva la expiración por inactividad.
SESSION_IDLE_MINUTES=60
SESSION_MAX_PER_USER=10
SESSION_CLEANUP_MINUTES=60
DOCS_ENABLED=true
COOKIE_SECURE=false
# Número de proxies de confianza; 0 en local. Usá 1 solo tras un proxy de borde que agregue X-Forwarded-For.
TRUST_PROXY_HOPS=0
DEMO_USER_EMAIL=demo@operia.local
DEMO_USER_PASSWORD=OperiaDemo-2026!
HOGAR_USER_EMAIL=hogar@operia.local
HOGAR_USER_PASSWORD=HogarDemo-2026!
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_IP_ATTEMPTS=30
RATE_LIMIT_LOGIN_ACCOUNT_ATTEMPTS=100
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_API_PER_MINUTE=600
RATE_LIMIT_ANONYMOUS_PER_MINUTE=100
# Las credenciales demo son públicas, no reutilizar.
RUN_SEED=true
ALLOWED_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=8
COOKIE_SECURE=false
DEMO_USER_EMAIL=demo@operia.local
DEMO_USER_PASSWORD=OperiaDemo-2026!
HOGAR_USER_EMAIL=hogar@operia.local
HOGAR_USER_PASSWORD=HogarDemo-2026!
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
